    "lightingRatios": {
      "keyLight": {
        "azimuthDegreesCameraLeft": 45,
        "elevationDegrees": 30,
        "cctKelvin": 4600,
        "minCri": 96,
        "minTlci": 97,
        "modifier": "90-to-120cm-double-diffused-octabox-with-40deg-eggcrate",
        "skinExposureIre": [58, 62]
      },
      "fillLight": {
        "keyToFillRatio": "4:1",
        "stopsBelowKey": -2.0,
        "cctKelvin": 4600,
        "shadowCheekIre": [32, 36]
      },
      "practicalDeskLamp": {
        "cctKelvinRange": [2700, 3000],
        "maxBulbShadeIre": 78,
        "deskPoolPurpose": "Warm tungsten motivation across cream filings and brass pen"
      },
      "rimHairLight": {
        "stopsBelowKey": -1.5,
        "cctKelvin": 5000,
        "backgroundWalnutIre": [18, 24]
      }
    },
    "deskProps": {
      "mandatoryAnchorProps": [
