        "preferredRegisters": ["smoked-navy-glass", "geospatial-telemetry", "archival-light-table", "milk-page-editorial"],
        "preferredStyleFamilies": ["liquid-glass", "data-maps-3d", "doc-broadcast"],
        "defaultForbiddenEngines": ["clocked", "ladder", "street"],
        "activeGuardrails": ["R43", "R44", "R45"]
      }
    }
  },
  "episodesVaultHandoffContract": {
    "vaultTargetFile": "studio/episodes-vault.json",
    "noveltyCooldownFormula": "weight_penalty = exp(-delta_episodes / 2.5)",
    "rollingLookbackEpisodes": 5,
    "requiredShowstopperSetPiecesPerEpisode": { "min": 3, "max": 5 },
    "episodeRecordSchema": {
      "type": "object",
      "required": [
        "episodeNumber",
        "episodeSlug",
        "title",
        "publishedIsoDate",
        "strategyId",
        "visualSignature",
        "styleCounts",
        "motionCombos",
        "propIds",
        "glassPresets",
        "typographyModes",
        "lutId",
        "musicStems",
        "showstopperBlueprints",
        "continuityEntities",
        "strategyAudit"
      ],
      "properties": {
        "episodeNumber": { "type": "integer", "minimum": 1, "maximum": 100 },
        "episodeSlug": { "type": "string", "pattern": "^ep_[0-9]{2}_[a-z0-9_]+$" },
        "title": { "type": "string", "minLength": 8 },
        "publishedIsoDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "strategyId": {
          "type": "string",
          "enum": [
            "STR-GEN-EXPLAINER",
            "STR-AIC-CLOCKED",
            "STR-AIC-SPECULATIVE",
            "STR-FISHER-ARTIFACT",
            "STR-MAX-ESSAY",
            "STR-AOTP-LADDER",
            "STR-BOYLE-CHAPTERED",
            "STR-HMW-PRIMER",
            "STR-GEN-FIELD"
          ]
        },
        "visualSignature": {
          "type": "object",
          "required": ["primaryRegister", "secondaryRegister", "mechanicalMotif", "scoreSuite"],
          "properties": {
            "primaryRegister": {
              "type": "string",
              "enum": [
                "milk-page-editorial",
                "smoked-navy-glass",
                "archival-light-table",
                "investigation-switchboard",
                "blueprint-schematic",
                "silver-gelatin-chronicle",
                "geospatial-telemetry",
                "restraint-vellum"
              ]
            },
            "secondaryRegister": {
              "type": "string",
              "enum": [
                "milk-page-editorial",
                "smoked-navy-glass",
                "archival-light-table",
                "investigation-switchboard",
                "blueprint-schematic",
                "silver-gelatin-chronicle",
                "geospatial-telemetry",
                "restraint-vellum"
              ]
            },
            "mechanicalMotif": { "type": "string" },
            "scoreSuite": {
              "type": "string",
              "enum": ["reading-room-chamber", "sovereign-pulse-synth", "forensic-clockwork"]
            }
          }
        },
        "styleCounts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "motionCombos": {
          "type": "array",
          "items": { "type": "string" }
        },
        "propIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "glassPresets": {
          "type": "array",
          "items": { "type": "string", "enum": ["card", "pill", "dock", "toast", "split-modal"] }
        },
        "typographyModes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "lutId": {
          "type": "string",
          "enum": ["editorial-warm", "documentary-slate", "clean-room-pop"]
        },
        "musicStems": {
          "type": "array",
          "items": { "type": "string" }
        },
        "showstopperBlueprints": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": { "type": "string" }
        },
        "continuityEntities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entityId", "label", "actStates"],
            "properties": {
              "entityId": { "type": "string", "pattern": "^ENT_[A-Z0-9_]+$" },
              "label": { "type": "string" },
              "actStates": {
                "type": "array",
                "minItems": 2,
                "items": { "type": "string" }
              }
            }
          }
        },
        "strategyAudit": {
          "type": "object",
          "required": [
            "strategyId",
            "forbiddenEngines",
            "stakes",
            "hasDatedHourTimeline",
            "hasShowablePrimaryArtifact",
            "hasFieldOrStreetFootage",
            "hookWordsToFirstStake",
            "thesisQuestionFrac",
            "coveredRehookDeciles",
            "adversaryConcessionFracs",
            "verdictFrac",
            "ctaFrac",
            "ctaCount",
            "latestNewFactFrac"
          ],
          "properties": {
            "strategyId": { "type": "string" },
            "forbiddenEngines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "stakes": { "type": "string", "enum": ["wallet", "civic", "wonder", "geopolitical", "valuation"] },
            "hasDatedHourTimeline": { "type": "boolean" },
            "hasShowablePrimaryArtifact": { "type": "boolean" },
            "hasFieldOrStreetFootage": { "type": "boolean" },
            "hookWordsToFirstStake": { "type": "integer", "minimum": 0 },
            "thesisQuestionFrac": { "type": "number", "minimum": 0, "maximum": 0.1 },
            "sponsorFrac": { "type": ["number", "null"] },
            "sponsorIsBridged": { "type": "boolean" },
            "coveredRehookDeciles": { "type": "array", "minItems": 10, "maxItems": 10, "items": { "type": "integer" } },
            "adversaryConcessionFracs": { "type": "array", "minItems": 1, "items": { "type": "number" } },
            "verdictFrac": { "type": "number", "minimum": 0.9, "maximum": 1.0 },
            "ctaFrac": { "type": "number", "minimum": 0.9, "maximum": 1.0 },
            "ctaCount": { "type": "integer", "const": 1 },
            "midVideoSubscribeAskCount": { "type": "integer", "const": 0 },
            "latestNewFactFrac": { "type": "number", "minimum": 0, "maximum": 0.9 },
            "presenterARollShare": { "type": "number", "minimum": 0.12, "maximum": 0.52 }
          }
        }
      }
    }
  }
}
