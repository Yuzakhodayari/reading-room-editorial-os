        "lutFile": "studio/luts/editorial-warm.cube",
        "lut3dSize": 17,
        "secondaryVaultLuts": ["documentary-slate", "clean-room-pop"],
        "lumaSharpenFilter": "unsharp=5:5:0.35:5:5:0.0",
        "pixelFormat": "yuv420p",
        "arollPrepCrf": 18,
        "cutawayMasterCrf": 14,
        "alphaOverlayCodecs": {
          "prores4444": "yuva444p10le",
          "vp9Webm": "yuva420p"
        }
      }
