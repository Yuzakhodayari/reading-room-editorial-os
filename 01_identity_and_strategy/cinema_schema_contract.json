        "chisel-tip-amber-highlighter-and-brick-red-annotations",
        "uncapped-dark-ebonite-or-brushed-brass-fountain-pen",
        "matte-dark-leather-or-walnut-desk-surface"
      ],
      "rotatingEpisodeArtifactSlot": true
    },
    "audioAndColorMaster": {
      "captureSampleRateHz": 48000,
      "captureBitDepth": 24,
      "maxRoomNoiseFloorDbfs": -58.0,
      "targetRt60Sec": [0.22, 0.32],
      "ebuR128Standard": "ITU-R BS.1770-4 two-pass linear loudnorm",
      "integratedLoudnessLufs": -14.0,
      "loudnessToleranceLu": 0.3,
      "truePeakCeilingDbtp": -1.0,
      "arollPrepLraLu": 11.0,
      "finalMasterLraLu": 7.0,
      "silenceTrim": {
        "thresholdDb": -34.0,
        "minSilenceSec": 0.65,
        "breathPadMs": 120
      },
      "fcpxmlAudioLanes": {
        "A1_dialogue": { "lane": 0, "targetLufs": -14.0 },
        "A2_proceduralFoley": { "lane": -1, "targetPeakRangeLufs": [-24.0, -20.0], "sampleRateHz": 48000 },
        "A3_documentaryScore": { "lane": -2, "duckedUnderVoiceLufs": [-32.0, -28.0], "musicEnergyStates": ["calm", "pulse", "tense", "drop-silence"] }
      },
