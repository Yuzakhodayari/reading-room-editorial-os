  "conflict_resolution_hierarchy": [
    {
      "tier": 1,
      "name": "House Restraint and Anti-AI Hard Locks",
      "rule": "Zero profanity, zero street slang, zero em dashes, zero double-hyphen splices, zero semicolons, zero exclamation marks, <50w cold-open stake, 15.5 to 17.5 mean sentence length, and <8.0 percent sentences >30 words override every raw creator transcript habit."
    },
    {
      "tier": 2,
      "name": "Primary Evidence Guardrail Supremacy (R43 to R48)",
      "rule": "Available verified primary sources outrank creator weight. AIC (7.0x) cannot force a clocked spine without verified hour-level records (R44), and Fisher (6.0x) cannot force an artifact spine without a showable primary filing or map (R47)."
    },
    {
      "tier": 3,
      "name": "Locked Strategy Preset Spine Ownership (R42, T43)",
      "rule": "Once channel-structure locks one STR-* preset, that preset owns the beat map, thesis cap, sponsor window, CTA archetype, and forbidden_engines list unless an explicit BACKTRACK fires."
    },
    {
      "tier": 4,
      "name": "Creator Multiplier Rank Tie-Breaker",
      "precedence_order": [
        "AIC (7.0x)",
        "Fisher (6.0x)",
        "Gen (5.0x)",
        "Maxinomics (4.5x)",
        "AotP (4.0x)",
        "HMW (2.5x) / Boyle (2.5x)"
      ],
      "specific_rulings": [
        {
          "collision": "Fisher (6.0x) counterparty fairness vs Gen (5.0x) moral indictment",
          "winner": "Fisher",
          "resolution": "State counterparty balance-sheet incentives fairly first (R19), then land Gen household wallet consequence."
        },
        {
          "collision": "AIC (7.0x) documentary composure vs Gen (5.0x) populist heat",
          "winner": "AIC",
          "resolution": "Keep vocal and lexical temperature calm, letting verified numbers against Friday rent supply the urgency."
        },
        {
          "collision": "Gen (5.0x) wallet cold open vs AotP (4.0x) slow historical derivation on solvency titles",
          "winner": "Gen",
          "resolution": "Enforce R45: land household stake inside 50 words and nest AotP toy models inside mid-film acts (0.34 to 0.60)."
        },
        {
          "collision": "AIC (7.0x) and Maxinomics (4.5x) compression vs Fisher (6.0x) multi-clause caveats",
          "winner": "AIC + Maxinomics",
          "resolution": "Split clauses exceeding 30 words into crisp declaratives and two-object unit ratios."
        }
      ]
    },
    {
      "tier": 5,
      "name": "Supporting Specialist Domain Split (HMW 2.5x vs Boyle 2.5x)",
      "rule": "Route market clearing, withholding, and covenant plumbing to HMW, and route 10-K footnotes, GAAP-vs-cash discrepancies, and sovereign bond spreads to Boyle."
    }
  ],
  "forbidden_moves": [
    {
      "rule_id": "R01",
      "axis": "structure",
      "severity": "P0",
      "name": "Late Cold-Open Stake",
      "validator_condition": "words_to_first_concrete_stake > 50 (house target) or > 60 (corpus hard fail)",
      "remediation": "Cut abstract throat-clearing and open directly on paycheck, filing, date, or physical object stake."
    },
    {
      "rule_id": "R02",
      "axis": "structure",
      "severity": "P0",
      "name": "Late or Agenda-Style Thesis",
      "validator_condition": "thesis_question_frac > preset.thesis_question_hard_cap_frac or matches agenda formula",
      "remediation": "State central thesis question before 0.08 and preview bays without spoiling failure mechanics."
    },
    {
      "rule_id": "R08",
      "axis": "structure",
      "severity": "P0",
      "name": "Illegal or Unbridged Sponsor Placement",
      "validator_condition": "sponsor present when allowed == false or outside preset.sponsor_policy.window or missing cliffhanger/re-entry",
      "remediation": "Remove ad on AIC/flagship runs or move inside preset window with R09 cliffhanger, R10 bridge, and R11 re-entry."
    },
    {
      "rule_id": "R19",
      "axis": "structure",
      "severity": "P0",
      "name": "Missing Fair Counterparty Concession",
      "validator_condition": "concession_count < preset.adversary_concession_min or absent in [0.60, 0.85]",
      "remediation": "Add steelman of strongest orthodox economic, engineering, or statutory counter-case before proving the break."
    },
    {
      "rule_id": "R22_HOUSE",
      "axis": "structure",
      "severity": "P0",
      "name": "Mid-Video Subscribe or Like Nag",
      "validator_condition": "cta_or_subscribe_ask_frac < 0.90",
      "remediation": "Delete all mid-roll subscribe or like prompts and restrict single lean-matched CTA to 0.97 to 1.00."
    },
    {
      "rule_id": "R37",
      "axis": "structure",
      "severity": "P0",
      "name": "Duplicated Drafting Span",
      "validator_condition": "repeated_verbatim_span_words >= 15",
      "remediation": "Deduplicate repeated drafting blocks while preserving intentional 2-to-6 word refrain tags (L08)."
    },
    {
      "rule_id": "R38",
      "axis": "structure",
      "severity": "P1",
      "name": "New Facts After 0.90 Verdict Boundary",
      "validator_condition": "new_empirical_stat_or_case_frac > 0.90",
      "remediation": "Move all empirical exhibits before 0.90 and reserve final 10 percent for callback, verdict, lever, and CTA."
    },
    {
      "rule_id": "R43",
      "axis": "structure",
      "severity": "P0",
      "name": "Empty Forbidden Engines Array",
      "validator_condition": "strategy_packet.forbidden_engines.length == 0",
      "remediation": "Diagnose title constraints and ban at least one incompatible narrative engine."
    },
    {
      "rule_id": "R44",
      "axis": "structure",
      "severity": "P0",
      "name": "Fake Crisis Hour-Stamps Without Verified Clock",
      "validator_condition": "clocked in forbidden_engines and script contains invented HH:MM crisis timestamps or doc-live-countdown-split",
      "remediation": "Keep dates strictly at verified calendar resolution (month, quarter, or year) and remove synthetic timers."
    },
    {
      "rule_id": "R45",
      "axis": "structure",
      "severity": "P1",
      "name": "Pure Toy-Model Spine on Household Solvency Title",
      "validator_condition": "stakes == wallet and primary_engine == ladder",
      "remediation": "Use STR-GEN-EXPLAINER or STR-HMW-PRIMER with <50w wallet stake and nest toy models inside one mid-film act."
    },
    {
      "rule_id": "R46",
      "axis": "structure",
      "severity": "P1",
      "name": "Fake Street or Field Framing in Studio Investigation",
      "validator_condition": "has_verified_field_shoot == false and primary_engine in [street, field]",
      "remediation": "Ban street and field engines, grounding evidence in primary filings and archival records."
    },
    {
      "rule_id": "R47",
      "axis": "structure",
      "severity": "P0",
      "name": "Artifact Engine Without Showable Primary Record",
      "validator_condition": "primary_engine == artifact and has_showable_primary_artifact == false",
      "remediation": "Acquire verified statutory filing, table, or map, or switch preset to STR-MAX-ESSAY or STR-AOTP-LADDER."
    },
    {
      "rule_id": "T43",
      "axis": "storytelling",
      "severity": "P0",
      "name": "Forbidden Engine Drift During Drafting",
      "validator_condition": "draft uses signature mechanics of an engine listed in strategy_packet.forbidden_engines",
      "remediation": "Strip drifted timestamps, vox-pop beats, or ungrounded Cold Open toy models to obey packet."
    },
    {
      "rule_id": "T44",
      "axis": "storytelling",
      "severity": "P0",
      "name": "Rotating Impersonal POV Spine",
      "validator_condition": "rotates impersonally across one/consumers/stakeholders without anchored human vehicle",
      "remediation": "Lock one longitudinal human character vehicle plus direct second-person you framing."
    },
    {
      "rule_id": "T46",
      "axis": "storytelling",
      "severity": "P1",
      "name": "Moral-Platitude Ending",
      "validator_condition": "final_5_pct ends on abstract societal wish without callback, concrete image, or balance-sheet lever",
      "remediation": "Close on T39 bookend callback, R26 ownership lever, and sharp institutional verdict."
    },
    {
      "rule_id": "A16",
      "axis": "audience",
      "severity": "P0",
      "name": "Unclosed or Prematurely Spoiled Open Loop",
      "validator_condition": "open_loop_unclosed_by_0_90 or escape_hatch_failure_spoiled_in_intro",
      "remediation": "Preview candidate hatches in intro, withhold failure mechanism until target bay, and close every loop before 0.90."
    },
    {
      "rule_id": "A23",
      "axis": "audience",
      "severity": "P1",
      "name": "Generic Comment Engagement Bait",
      "validator_condition": "matches generic thoughts-in-comments filler",
      "remediation": "Ask one specific, contested institutional or balance-sheet question in final 10 percent."
    },
    {
      "rule_id": "A42_A43",
      "axis": "audience",
      "severity": "P0",
      "name": "Audience Device Density Out of Bounds",
      "validator_condition": "devices_per_1k < 3.0 or devices_per_1k > 8.0",
      "remediation": "Inject A01/A03/L05 if below 3.0/1k, or prune P2 humor and stackers first if above 8.0/1k."
    },
    {
      "rule_id": "A44",
      "axis": "audience",
      "severity": "P0",
      "name": "Fabricated Personal Experience or Financial Position",
      "validator_condition": "claims unverified narrator trade, possession, or lived event",
      "remediation": "Remove invented experience immediately and restrict narrator stake to verified age/generational facts."
    },
    {
      "rule_id": "L13_L14_HOUSE",
      "axis": "language",
      "severity": "P0",
      "name": "Profanity or Street Slang Violation",
      "validator_condition": "profanity_count > 0 or street_slang_count > 0",
      "remediation": "Replace with crisp shirt-and-tie plain English or Boyle-style deadpan understatement."
    },
    {
      "rule_id": "L31",
      "axis": "language",
      "severity": "P0",
      "name": "Ornamental Abstract Noun Triad",
      "validator_condition": "three_abstract_nouns_conjoined_for_rhythm > 0",
      "remediation": "Replace abstract triad with concrete named institutions, numbers, or two-part direct claims."
    },
    {
      "rule_id": "L32_L50",
      "axis": "language",
      "severity": "P0",
      "name": "Banned AI Vocabulary or Negative-Contrast Crutch",
      "validator_condition": "banned_ai_word_hits > 0 or negative_contrast_pivot_hits > 0",
      "remediation": "Rewrite directly as positive factual statements using plain verbs and verified numbers."
    },
    {
      "rule_id": "L33_HOUSE",
      "axis": "language",
      "severity": "P0",
      "name": "Forbidden Punctuation Token (Em Dash, Double Hyphen, Semicolon, Exclamation)",
      "validator_condition": "em_dash_count > 0 or double_hyphen_count > 0 or semicolon_count > 0 or exclamation_count > 0",
      "remediation": "Split at semicolons, replace dashes with commas/colons/periods, and cut all exclamation marks."
    },
    {
      "rule_id": "L46",
      "axis": "language",
      "severity": "P0",
      "name": "Detector Gate Failure or Soft-Pass",
      "validator_condition": "detector_score > 2 (pipeline ceiling) or > 0 (house target)",
      "remediation": "Repair flagged spans iteratively (max 3 loops) without regenerating facts or planting fake typos (L48)."
    },
    {
      "rule_id": "L51",
      "axis": "language",
      "severity": "P1",
      "name": "Flat Sentence Rhythm or Equal-Length Run",
      "validator_condition": "mean_words < 15.5 or mean_words > 17.5 or pct_gt_30w >= 8.0 or consecutive_equal_word_count_run >= 3",
      "remediation": "Alternate 22-to-29-word analytical builds with 4-to-8-word declarative punches."
    }
  ],
